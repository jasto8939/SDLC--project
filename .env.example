# Copy to .env or set in your shell / CI context. NEVER commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SSL_REDIRECT=1

# Scanner (optional)
# SDLCGUARD_SCAN_PATHS=C:\Users\you\projects\app1;C:\Users\you\projects\app2
# SDLCGUARD_SCAN_MACHINE=1
# SDLCGUARD_GITHUB_REPO=owner/repo
# SDLCGUARD_GITHUB_TOKEN=read-only-token
